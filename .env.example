# Copy to .env — docker compose reads it automatically
FRONTEND_PORT=5173
BACKEND_PORT=3000
DB_PORT=5432

# Local LLM chat (Ollama on the host). `ollama list` shows what you have pulled;
# the model must support tool calling.
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TEMPERATURE=0.3
# Context window. Ollama silently drops the oldest messages past this, so raise
# it if answers start ignoring earlier tool results — at the cost of more VRAM.
# OLLAMA_NUM_CTX=65536
# OLLAMA_THINK=false
# CHAT_MAX_TOOL_ROUNDS=6
# How long Ollama holds the model in memory after a request. Its own default is
# 5m, after which the next question pays the weight load again. "-1" pins it for
# good, which is fastest and holds the VRAM until you unload it by hand.
# OLLAMA_KEEP_ALIVE=30m
# Prefill the system prompt and tool schemas on boot and when the chat page
# opens. Set false to leave the GPU idle until someone actually asks something.
# OLLAMA_WARMUP=true

# Publish our own tools over MCP at /api/mcp for Claude Code, Claude Desktop and
# other agents. Generate with `openssl rand -hex 24`. Leave unset to keep the
# endpoint disabled.
# MCP_HTTP_TOKEN=

# MCP servers the chat can call, as JSON. Defaults to the bundled Sleeper server.
# MCP_SERVERS=[{"name":"sleeper","command":"node","args":["/app/node_modules/sleeper-mcp/dist/index.js"]}]
